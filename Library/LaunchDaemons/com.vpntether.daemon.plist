<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vpntether.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/bash</string>
        <string>/Library/VPNTether/pfinject_daemon.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/vpntether/daemon_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/vpntether/daemon_stderr.log</string>
</dict>
</plist>
